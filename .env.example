# coresight-g — 환경변수 전체 목록 (예시)
# 복사: cp .env.example .env.local → 값 입력 후 사용
# 주의: .env.dev/.env.staging/.env.prod 는 git 미추적 (Vault/Secret Manager 사용 권장)

# ── 앱 기본 ──────────────────────────────────────────────────────────────────
APP_NAME=coresight-g
ENV=local                             # local | dev | staging | prod

# ── 데이터베이스 ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./local.db     # local: sqlite / dev+: postgresql://...
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 인증 (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM   # openssl rand -hex 32 or openssl rand -base64 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM Provider — Claude (Anthropic) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...              # https://console.anthropic.com
ORCHESTRATOR_MODEL=claude-sonnet-4-6
DOMAIN_AGENT_MODEL=claude-haiku-4-5-20251001

# ── LLM Provider — OpenAI (선택) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── LLM Provider — Google Gemini (선택) ──────────────────────────────────────
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-flash

# ── LLM Provider — Ollama (로컬 폴백) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── LLM Gateway — LiteLLM Proxy (선택) ───────────────────────────────────────
# LLM_GATEWAY_URL=http://localhost:4000

# ── Setup Wizard ─────────────────────────────────────────────────────────────
SETUP_COMPLETED=false
DEFAULT_ADMIN_USER_ID=admin
DEFAULT_ADMIN_PASSWORD=Admin123!      # 최초 구동 후 반드시 변경

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:4100","http://example.com"]

# ── 포트 설정 (docker-compose 포트 매핑 및 서비스 기동에 사용) ─────────────────
# 동일 호스트에서 여러 환경 동시 실행 시 충돌 방지를 위해 변경 가능
BACKEND_PORT=8100
FRONTEND_PORT=4100
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# ── MCP 외부 노출 호스트 (Docker/NAT 환경) ───────────────────────────────────
# MCP_HOST=192.168.1.100   # 호스트 IP 또는 도메인 (Docker Compose 환경에서 필수)

# ── Standalone Agent (F12, 선택) ──────────────────────────────────────────────
# AGENT_STANDALONE=false
# AGENT_KEY=example
# AGENT_PORT=8001
# AGENT_BASE_URL=http://localhost:8001
# AGENT_EXPOSE_PROTOCOL=a2a,mcp

# Prometheus (GPU/HW 메트릭 조회)
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090
MOCK_EXPORTER_PORT=9400

# Alertmanager 알림 채널
ALERTMANAGER_PORT=9093
ALERT_WEBHOOK_TOKEN=coresight-webhook-token
NOTIFY_WEBHOOK_URL=

# Loki (로그 수집·검색)
LOKI_URL=http://localhost:3100
LOKI_PORT=3100

# OpenTelemetry 트레이스 (Jaeger)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_URL=http://localhost:16686
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318
