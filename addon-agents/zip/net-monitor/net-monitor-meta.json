{
  "agent_type": "monitoring",
  "version": "1.0.0",
  "display_name": "네트워크 모니터링 Agent",
  "description": "NIC 오류/드롭/링크상태/처리량을 조회·진단하는 관제 Agent입니다",
  "capabilities": [
    {
      "verb": "network",
      "domain": "observability.network",
      "description": "NIC 스냅샷·활성 알람·PromQL 조회 (read-only)",
      "input_schema": {
        "type": "object",
        "properties": {
          "tool_name": {"type": "string", "enum": ["get_nic_snapshot", "get_active_alerts", "query_promql"]},
          "arguments": {"type": "object"}
        },
        "required": ["tool_name"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {"type": "object"}
        }
      },
      "qos": {
        "max_latency_ms": 10000,
        "supports_async": false,
        "supports_streaming": false
      }
    }
  ],
  "governance": {
    "data_classification": "internal",
    "human_approval_required": false,
    "audit_level": "standard"
  },
  "required_env": [],
  "optional_env": ["PROMETHEUS_URL"],
  "min_platform_version": "2.0.0"
}
