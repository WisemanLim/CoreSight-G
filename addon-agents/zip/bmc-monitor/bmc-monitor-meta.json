{
  "agent_type": "monitoring",
  "version": "1.0.0",
  "display_name": "BMC/IPMI Agent",
  "description": "BMC 센서(팬·전압·PSU·온도·전력, Prometheus)와 BMC 이벤트 로그(Loki)를 결합 조회·진단하는 관제 Agent입니다",
  "capabilities": [
    {
      "verb": "bmc",
      "domain": "observability.bmc",
      "description": "BMC 센서 스냅샷·이벤트 로그·활성 알람 조회 (read-only)",
      "input_schema": {
        "type": "object",
        "properties": {
          "tool_name": {"type": "string", "enum": ["get_bmc_sensors", "get_bmc_events", "get_active_alerts"]},
          "arguments": {"type": "object"}
        },
        "required": ["tool_name"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {"type": "object"}
        }
      },
      "qos": {
        "max_latency_ms": 10000,
        "supports_async": false,
        "supports_streaming": false
      }
    }
  ],
  "governance": {
    "data_classification": "internal",
    "human_approval_required": false,
    "audit_level": "standard"
  },
  "required_env": [],
  "optional_env": ["PROMETHEUS_URL", "LOKI_URL"],
  "min_platform_version": "2.0.0"
}
