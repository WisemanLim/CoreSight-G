{
  "agent_type": "monitoring",
  "version": "1.0.0",
  "display_name": "워크로드 상관 Agent",
  "description": "프로세스/잡별 GPU 점유를 스케줄러 메타데이터와 연계 분석하는 관제 Agent입니다",
  "capabilities": [
    {
      "verb": "workload_correlation",
      "domain": "observability.workload",
      "description": "GPU 프로세스 맵·잡별/사용자별 점유 집계 조회 (read-only)",
      "input_schema": {
        "type": "object",
        "properties": {
          "tool_name": {"type": "string", "enum": ["get_gpu_process_map", "get_usage_by_job", "get_usage_by_user"]},
          "arguments": {"type": "object"}
        },
        "required": ["tool_name"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {"type": "object"}
        }
      },
      "qos": {
        "max_latency_ms": 10000,
        "supports_async": false,
        "supports_streaming": false
      }
    }
  ],
  "governance": {
    "data_classification": "internal",
    "human_approval_required": false,
    "audit_level": "standard"
  },
  "required_env": [],
  "optional_env": ["PROMETHEUS_URL"],
  "min_platform_version": "2.0.0"
}
