{
  "agent_type": "monitoring",
  "version": "1.0.0",
  "display_name": "이상 탐지 Agent",
  "description": "z-score 기반 메트릭 이상 탐지와 알람 상관분석으로 원인 조사를 보조하는 관제 Agent입니다",
  "capabilities": [
    {
      "verb": "anomaly_detection",
      "domain": "observability.anomaly",
      "description": "메트릭 이상 탐지·알람 상관 조회 (read-only)",
      "input_schema": {
        "type": "object",
        "properties": {
          "tool_name": {"type": "string", "enum": ["detect_metric_anomalies", "correlate_alerts"]},
          "arguments": {"type": "object"}
        },
        "required": ["tool_name"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {"type": "object"}
        }
      },
      "qos": {
        "max_latency_ms": 15000,
        "supports_async": false,
        "supports_streaming": false
      }
    }
  ],
  "governance": {
    "data_classification": "internal",
    "human_approval_required": false,
    "audit_level": "standard"
  },
  "required_env": [],
  "optional_env": ["PROMETHEUS_URL"],
  "min_platform_version": "2.0.0"
}
