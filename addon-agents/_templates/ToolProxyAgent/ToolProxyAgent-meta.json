{
  "agent_type": "tool-proxy",
  "version": "1.0.0",
  "display_name": "Tool Proxy Agent",
  "description": "외부 REST API를 MCP Tool로 변환하는 어댑터 Agent입니다",
  "capabilities": [
    {
      "verb": "proxy",
      "domain": "integration.external-api",
      "description": "외부 REST API 도구를 MCP로 노출합니다",
      "input_schema": {
        "type": "object",
        "properties": {
          "tool_name": {"type": "string"},
          "arguments": {"type": "object"}
        },
        "required": ["tool_name", "arguments"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {"type": "object"},
          "status_code": {"type": "integer"}
        }
      },
      "qos": {
        "max_latency_ms": 10000,
        "supports_async": false,
        "supports_streaming": false
      }
    }
  ],
  "governance": {
    "data_classification": "internal",
    "human_approval_required": false,
    "audit_level": "standard"
  },
  "required_env": ["TOOL_PROXY_BASE_URL"],
  "optional_env": ["TOOL_PROXY_API_KEY"],
  "min_platform_version": "2.0.0"
}
