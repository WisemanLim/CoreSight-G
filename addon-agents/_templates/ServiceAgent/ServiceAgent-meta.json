{
  "agent_type": "service",
  "version": "1.0.0",
  "display_name": "서비스 Agent",
  "description": "백엔드 비즈니스 로직을 수행하는 서비스 Agent입니다",
  "capabilities": [
    {
      "verb": "process",
      "domain": "service.default",
      "description": "입력 데이터를 처리하고 결과를 반환합니다",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {"type": "object"}
        },
        "required": ["input"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "output": {"type": "object"},
          "status": {"type": "string"}
        }
      },
      "qos": {
        "max_latency_ms": 10000,
        "supports_async": true,
        "supports_streaming": true
      }
    }
  ],
  "governance": {
    "data_classification": "internal",
    "human_approval_required": false,
    "audit_level": "standard"
  },
  "required_env": [],
  "optional_env": ["ANTHROPIC_API_KEY"],
  "min_platform_version": "2.0.0"
}
